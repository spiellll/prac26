{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ритм — Flask API и сайт",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "args": ["--app", "backend.wsgi:app", "run", "--port", "5001", "--no-reload"],
      "env": {"FLASK_DEBUG": "1"},
      "console": "integratedTerminal",
      "jinja": true
    }
  ]
}
