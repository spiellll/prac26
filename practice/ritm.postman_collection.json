{
  "info": {
    "name": "Ритм — REST API дневника (летняя практика)",
    "description": "Учебный цикл CRUD для существующего дневника тренировок. Используется только синтетическая запись с выделенным UUID. Запускать по порядку на локальном backend или учебной копии. JSON является форматом API; SQLite — хранилищем.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001",
      "type": "string"
    },
    {
      "key": "entryId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Сервис доступен",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Заметки: фильтр и пагинация",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries?kind=note&page=1&per_page=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Создать учебную заметку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{entryId}}\",\n  \"date\": \"2026-07-01\",\n  \"kind\": \"note\",\n  \"text\": \"Проверка CRUD для летней практики. Синтетическая запись.\",\n  \"title\": \"Учебная заметка\",\n  \"exercises\": [],\n  \"value\": null,\n  \"cycleIndex\": null,\n  \"createdAt\": \"2026-07-01T10:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('entryId', pm.variables.replaceIn('{{$guid}}')); // Fresh ID for every CRUD run"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Получить заметку",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries/{{entryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Изменить текст",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries/{{entryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Текст изменён через PATCH. Учебный цикл CRUD выполнен.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Повторный id: конфликт",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{entryId}}\",\n  \"date\": \"2026-07-01\",\n  \"kind\": \"note\",\n  \"text\": \"Проверка CRUD для летней практики. Синтетическая запись.\",\n  \"title\": \"Учебная заметка\",\n  \"exercises\": [],\n  \"value\": null,\n  \"cycleIndex\": null,\n  \"createdAt\": \"2026-07-01T10:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Некорректный тип записи",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"22222222-2222-4222-8222-222222222222\",\n  \"date\": \"2026-07-01\",\n  \"kind\": \"unknown\",\n  \"text\": \"Проверка CRUD для летней практики. Синтетическая запись.\",\n  \"title\": \"Учебная заметка\",\n  \"exercises\": [],\n  \"value\": null,\n  \"cycleIndex\": null,\n  \"createdAt\": \"2026-07-01T10:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Удалить учебную заметку",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries/{{entryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Удалённая запись: 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entries/{{entryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
